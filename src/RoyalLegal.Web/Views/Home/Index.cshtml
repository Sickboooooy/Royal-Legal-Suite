@{
    Layout = "_Layout";
}

<div class="text-center">
    <h1 class="display-4 text-primary mb-4">Welcome to Royal Legal Suite</h1>
    <p class="lead">Your comprehensive legal practice management solution</p>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="fas fa-users fa-3x text-primary mb-3"></i>
                <h5 class="card-title">Client Management</h5>
                <p class="card-text">Manage your clients' information, contact details, and case history in one centralized location.</p>
                <a href="/Clients" class="btn btn-primary">Manage Clients</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="fas fa-briefcase fa-3x text-success mb-3"></i>
                <h5 class="card-title">Case Management</h5>
                <p class="card-text">Track case progress, deadlines, court dates, and all case-related activities efficiently.</p>
                <a href="/Cases" class="btn btn-success">View Cases</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="fas fa-file-alt fa-3x text-info mb-3"></i>
                <h5 class="card-title">Document Management</h5>
                <p class="card-text">Store, organize, and share legal documents securely with clients and team members.</p>
                <a href="/Documents" class="btn btn-info">Manage Documents</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="fas fa-clock fa-3x text-warning mb-3"></i>
                <h5 class="card-title">Time Tracking</h5>
                <p class="card-text">Track billable hours, expenses, and generate accurate invoices for your clients.</p>
                <a href="/TimeTracking" class="btn btn-warning">Track Time</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="fas fa-dollar-sign fa-3x text-danger mb-3"></i>
                <h5 class="card-title">Billing & Invoicing</h5>
                <p class="card-text">Generate professional invoices, track payments, and manage your firm's financial health.</p>
                <a href="/Billing" class="btn btn-danger">View Billing</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="fas fa-chart-bar fa-3x text-secondary mb-3"></i>
                <h5 class="card-title">Reports & Analytics</h5>
                <p class="card-text">Get insights into your practice with comprehensive reports and performance analytics.</p>
                <a href="/Reports" class="btn btn-secondary">View Reports</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5">
    <div class="col-12">
        <div class="alert alert-info">
            <h4 class="alert-heading">Quick Stats</h4>
            <div class="row text-center">
                <div class="col-md-3">
                    <h5 class="text-primary">156</h5>
                    <small>Active Cases</small>
                </div>
                <div class="col-md-3">
                    <h5 class="text-success">342</h5>
                    <small>Total Clients</small>
                </div>
                <div class="col-md-3">
                    <h5 class="text-warning">1,247</h5>
                    <small>Documents</small>
                </div>
                <div class="col-md-3">
                    <h5 class="text-info">$284,750</h5>
                    <small>Monthly Revenue</small>
                </div>
            </div>
        </div>
    </div>
</div>